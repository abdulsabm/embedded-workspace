line level    source

   1          #include "reg51.h"
   2          #include "../include.h"
   3          #include "lcd.h"
   4          
   5          #define LCD_DATA_16x2 P1  // Data port for the LCD
   6          
   7          sbit LCD_RS_16x2 = P0^0;  // Register select pin
   8          sbit LCD_RW_16x2 = P0^1;  // Read/Write pin
   9          sbit LCD_EN_16x2 = P0^2;  // Enable pin
  10          
  11          void lcd_cmd(unsigned char cmd) {
  12   1          LCD_RS_16x2 = 0;  // Select command register
  13   1          LCD_RW_16x2 = 0;  // Set to write mode
  14   1          LCD_DATA_16x2 = cmd;  // Send command byte
  15   1          
  16   1          // Enable Pulse (Falling Edge Latches Data)
  17   1          LCD_EN_16x2 = 1;
  18   1          delay(5);
  19   1          LCD_EN_16x2 = 0;
  20   1          delay(5);
  21   1      }
  22          
  23          void display_value(unsigned char value) {
  24   1          LCD_RS_16x2 = 1;  // Select data register
  25   1          LCD_RW_16x2 = 0;  // Set to write mode
  26   1          LCD_DATA_16x2 = value;  // Send character byte
  27   1          
  28   1          // Enable Pulse (Falling Edge Latches Data)
  29   1          LCD_EN_16x2 = 1;
  30   1          delay(5);
  31   1          LCD_EN_16x2 = 0;
  32   1          delay(5);
  33   1      }
  34          
  35          void main() {
  36   1          delay(5);  // Power-on delay (Wait for LCD internal controller to boot)
  37   1      
  38   1          // 1. Mandatory 8-bit, 2-line initialization
  39   1          lcd_cmd(FUNCTION_SET_2_LINE_5X7);  
  40   1          
  41   1          // 2. Turn on Display
  42   1          lcd_cmd(DISPLAY_ON_CURSOR_ON_BLINK_OFF);
  43   1          
  44   1          // 3. Clear Screen
  45   1          lcd_cmd(CLEAR_DISPLAY);
  46   1          
  47   1          // 4. Send Character
  48   1          display_value('h');
  49   1          delay(500);
  50   1          lcd_cmd(CLEAR_DISPLAY);
  51   1          lcd_cmd(DISPLAY_ON_CURSOR_ON_BLINK_ON);
  52   1          display_value('z');
  53   1          delay(500);
  54   1      
